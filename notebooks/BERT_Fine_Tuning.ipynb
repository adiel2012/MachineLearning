  {
   "cell_type": "code",
   "source": [
    "# 4. FINE-TUNING TRAINING LOOP\n",
    "print(f\"\\n4️⃣ Fine-Tuning Training Implementation\")\n",
    "print(\"=\" * 45)\n",
    "\n",
    "class BERTFineTuner:\n",
    "    \"\"\"\n",
    "    Complete fine-tuning setup for BERT downstream tasks\n",
    "    \"\"\"\n",
    "    def __init__(self, model: nn.Module, task_type: str, learning_rate: float = 2e-5):\n",
    "        self.model = model\n",
    "        self.task_type = task_type\n",
    "        self.device = next(model.parameters()).device\n",
    "\n",
    "        # Fine-tuning typically uses lower learning rate\n",
    "        self.optimizer = optim.AdamW(model.parameters(), lr=learning_rate, weight_decay=0.01)\n",
    "\n",
    "        # Task-specific loss functions\n",
    "        if task_type == 'classification':\n",
    "            self.loss_fn = nn.CrossEntropyLoss()\n",
    "        elif task_type == 'token_classification':\n",
    "            self.loss_fn = nn.CrossEntropyLoss(ignore_index=-100)  # Ignore padding\n",
    "        elif task_type == 'qa':\n",
    "            self.loss_fn = nn.CrossEntropyLoss()\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown task type: {task_type}\")\n",
    "\n",
    "        # Metrics tracking\n",
    "        self.metrics = {'loss': [], 'accuracy': []}\n",
    "\n",
    "    def train_step(self, batch: Dict[str, torch.Tensor]) -> Dict[str, float]:\n",
    "        \"\"\"Single fine-tuning step\"\"\"\n",
    "        self.model.train()\n",
    "\n",
    "        # Move to device\n",
    "        input_ids = batch['input_ids'].to(self.device).long()\n",
    "        attention_mask = batch['attention_mask'].to(self.device).float()\n",
    "\n",
    "        segment_ids = batch.get('segment_ids')\n",
    "        if segment_ids is not None:\n",
    "            segment_ids = segment_ids.to(self.device).long()\n",
    "\n",
    "        # Handle labels based on task type\n",
    "        if self.task_type == 'qa':\n",
    "            # QA has nested labels dict - handle each component separately\n",
    "            labels = batch['labels'] # This is a dict with 'start_positions' and 'end_positions'\n",
    "            start_positions = labels['start_positions'].to(self.device).long()\n",
    "            end_positions = labels['end_positions'].to(self.device).long()\n",
    "        else:\n",
    "            # Classification and token classification have simple tensor labels\n",
    "            labels = batch['labels'].to(self.device).long()\n",
    "\n",
    "        # Forward pass\n",
    "        if self.task_type == 'classification':\n",
    "            logits = self.model(input_ids, attention_mask, segment_ids)\n",
    "            loss = self.loss_fn(logits, labels)\n",
    "\n",
    "            # Calculate accuracy\n",
    "            predictions = torch.argmax(logits, dim=-1)\n",
    "            accuracy = (predictions == labels).float().mean()\n",
    "\n",
    "        elif self.task_type == 'token_classification':\n",
    "            logits = self.model(input_ids, attention_mask, segment_ids)\n",
    "            loss = self.loss_fn(logits.view(-1, logits.size(-1)), labels.view(-1))\n",
    "\n",
    "            # Calculate token-level accuracy (ignoring padding)\n",
    "            predictions = torch.argmax(logits, dim=-1)\n",
    "            mask = labels != -100\n",
    "            accuracy = ((predictions == labels) & mask).float().sum() / mask.float().sum()\n",
    "\n",
    "        elif self.task_type == 'qa':\n",
    "            outputs = self.model(input_ids, attention_mask, segment_ids)\n",
    "            start_loss = self.loss_fn(outputs['start_logits'], start_positions)\n",
    "            end_loss = self.loss_fn(outputs['end_logits'], end_positions)\n",
    "            loss = (start_loss + end_loss) / 2\n",
    "\n",
    "            # Simple QA accuracy (both start and end must be correct)\n",
    "            start_preds = torch.argmax(outputs['start_logits'], dim=-1)\n",
    "            end_preds = torch.argmax(outputs['end_logits'], dim=-1)\n",
    "            accuracy = ((start_preds == start_positions) &\n",
    "                       (end_preds == end_positions)).float().mean()\n",
    "\n",
    "        # Backward pass\n",
    "        self.optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=1.0)\n",
    "        self.optimizer.step()\n",
    "\n",
    "        # Track metrics\n",
    "        metrics = {\n",
    "            'loss': loss.item(),\n",
    "            'accuracy': accuracy.item()\n",
    "        }\n",
    "\n",
    "        for key, value in metrics.items():\n",
    "            self.metrics[key].append(value)\n",
    "\n",
    "        return metrics\n",
    "\n",
    "    def evaluate(self, dataloader) -> Dict[str, float]:\n",
    "        \"\"\"Evaluate model on validation/test set\"\"\"\n",
    "        self.model.eval()\n",
    "        total_loss = 0\n",
    "        total_accuracy = 0\n",
    "        num_batches = 0\n",
    "\n",
    "        with torch.no_grad():\n",
    "            for batch in dataloader:\n",
    "                metrics = self.train_step(batch)  # Note: no gradient update in eval mode\n",
    "                total_loss += metrics['loss']\n",
    "                total_accuracy += metrics['accuracy']\n",
    "                num_batches += 1\n",
    "\n",
    "        return {\n",
    "            'avg_loss': total_loss / num_batches,\n",
    "            'avg_accuracy': total_accuracy / num_batches\n",
    "        }\n",
    "\n",
    "print(\"✅ Fine-tuning framework implemented:\")\n",
    "print(\"   • Task-specific loss functions\")\n",
    "print(\"   • Lower learning rate for fine-tuning\")\n",
    "print(\"   • Proper evaluation metrics\")\n",
    "print(\"   • Gradient clipping for stability\")"
   ],
