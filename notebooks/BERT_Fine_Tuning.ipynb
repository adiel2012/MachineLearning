    "# Part IV: 🔧 Fine-Tuning BERT for Downstream Tasks\n",
    "\n",
    "print(\"🔧 Part IV: Fine-Tuning BERT for Downstream Tasks\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(\"🎯 Adapting pre-trained BERT for specific NLP tasks\")\n",
    "print(\"🏆 Tasks: Classification, QA, NER, and more\")\n",
    "print()\n",
    "\n",
    "# 1. BERT FOR SEQUENCE CLASSIFICATION\n",
    "print(\"1️⃣ BERT for Sequence Classification\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "class BERTForSequenceClassification(nn.Module):\n",
    "    \"\"\"\n",
    "    BERT model for sequence classification tasks (sentiment analysis, etc.)\n",
    "    \"\"\"\n",
    "    def __init__(self, bert_model, num_classes: int, dropout: float = 0.1):\n",
    "        super().__init__()\n",
    "        self.bert = bert_model\n",
    "        self.num_classes = num_classes\n",
    "\n",
    "        # Classification head\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "        self.classifier = nn.Linear(bert_model.config['d_model'], num_classes)\n",
    "\n",
    "        # Freeze BERT embeddings optionally (common practice)\n",
    "        # self.bert.embeddings.requires_grad_(False)\n",
    "\n",
    "    def forward(self, input_ids: torch.Tensor, attention_mask: torch.Tensor,\n",
    "                segment_ids: Optional[torch.Tensor] = None) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            input_ids: (batch_size, seq_len)\n",
    "            attention_mask: (batch_size, seq_len)\n",
    "            segment_ids: (batch_size, seq_len)\n",
    "        Returns:\n",
    "            (batch_size, num_classes) - classification logits\n",
    "        \"\"\"\n",
    "        # Get BERT representations\n",
    "        outputs = self.bert(input_ids, attention_mask, segment_ids)\n",
    "\n",
    "        # Use [CLS] token (first position) for classification\n",
    "        cls_output = outputs['last_hidden_state'][:, 0]  # (batch_size, d_model)\n",
    "        cls_output = self.dropout(cls_output)\n",
    "        logits = self.classifier(cls_output)\n",
    "\n",
    "        return logits\n",
    "\n",
    "# 2. BERT FOR TOKEN CLASSIFICATION (NER)\n",
    "print(\"\\n2️⃣ BERT for Token Classification (NER)\")\n",
    "print(\"=\" * 45)\n",
    "\n",
    "class BERTForTokenClassification(nn.Module):\n",
    "    \"\"\"\n",
    "    BERT model for token classification tasks (NER, POS tagging, etc.)\n",
    "    \"\"\"\n",
    "    def __init__(self, bert_model, num_labels: int, dropout: float = 0.1):\n",
    "        super().__init__()\n",
    "        self.bert = bert_model\n",
    "        self.num_labels = num_labels\n",
    "\n",
    "        # Token classification head\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "        self.classifier = nn.Linear(bert_model.config['d_model'], num_labels)\n",
    "\n",
    "    def forward(self, input_ids: torch.Tensor, attention_mask: torch.Tensor,\n",
    "                segment_ids: Optional[torch.Tensor] = None) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            input_ids: (batch_size, seq_len)\n",
    "            attention_mask: (batch_size, seq_len)\n",
    "            segment_ids: (batch_size, seq_len)\n",
    "        Returns:\n",
    "            (batch_size, seq_len, num_labels) - token classification logits\n",
    "        \"\"\"\n",
    "        # Get BERT representations\n",
    "        outputs = self.bert(input_ids, attention_mask, segment_ids)\n",
    "\n",
    "        # Apply token classification head to all positions\n",
    "        sequence_output = outputs['last_hidden_state']\n",
    "        sequence_output = self.dropout(sequence_output)\n",
    "        logits = self.classifier(sequence_output)\n",
    "\n",
    "        return logits\n",
    "\n",
    "# 3. BERT FOR QUESTION ANSWERING\n",
    "print(\"\\n3️⃣ BERT for Question Answering\")\n",
    "print(\"=\" * 35)\n",
    "\n",
    "class BERTForQuestionAnswering(nn.Module):\n",
    "    \"\"\"\n",
    "    BERT model for extractive question answering (SQuAD-style)\n",
    "    \"\"\"\n",
    "    def __init__(self, bert_model):\n",
    "        super().__init__()\n",
    "        self.bert = bert_model\n",
    "\n",
    "        # QA head predicts start and end positions\n",
    "        self.qa_outputs = nn.Linear(bert_model.config['d_model'], 2)\n",
    "\n",
    "    def forward(self, input_ids: torch.Tensor, attention_mask: torch.Tensor,\n",
    "                segment_ids: Optional[torch.Tensor] = None) -> Dict[str, torch.Tensor]:\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            input_ids: (batch_size, seq_len) - concatenated question + context\n",
    "            attention_mask: (batch_size, seq_len)\n",
    "            segment_ids: (batch_size, seq_len) - 0 for question, 1 for context\n",
    "        Returns:\n",
    "            Dict with start_logits and end_logits, both (batch_size, seq_len)\n",
    "        \"\"\"\n",
    "        # Get BERT representations\n",
    "        outputs = self.bert(input_ids, attention_mask, segment_ids)\n",
    "\n",
    "        # Apply QA head\n",
    "        sequence_output = outputs['last_hidden_state']\n",
    "        logits = self.qa_outputs(sequence_output)\n",
    "\n",
    "        start_logits, end_logits = logits.split(1, dim=-1)\n",
    "        start_logits = start_logits.squeeze(-1)  # (batch_size, seq_len)\n",
    "        end_logits = end_logits.squeeze(-1)      # (batch_size, seq_len)\n",
    "\n",
    "        return {\n",
    "            'start_logits': start_logits,\n",
    "            'end_logits': end_logits\n",
    "        }\n",
    "\n",
    "print(\"✅ Fine-tuning architectures implemented:\")\n",
    "print(\"   • Sequence Classification: Sentiment, topic classification\")\n",
    "print(\"   • Token Classification: NER, POS tagging\")\n",
    "print(\"   • Question Answering: Extractive QA systems\")"
   ],
